APP_ENV=production
PORT=8000
WEB_CONCURRENCY=1
GRACEFUL_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_HISTORY=10
MAX_REQUEST_BODY_BYTES=16384
CATALOG_PATH=app/services/default.json
PRODUCT_VOCABULARY_PATH=app/services/product_vocabulary.json
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-PRODUCTION-DOMAIN.example
WHATSAPP_VERIFY_TOKEN=SET_VIA_AWS_SECRETS_MANAGER
